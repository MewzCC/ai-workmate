# ===================================================================
# AI WorkMate Docker 部署环境变量配置模板
# ===================================================================
# 使用方法：复制本文件为 .env，然后根据实际环境填入真实值
#   cp .env.docker.example .env
# 然后执行：docker compose up -d --build
#
# 本文件是 Docker 部署的完整配置模板，可直接独立使用。
# 与本地开发（.env.example）的差异：
#   - 不含 REDIS_URL / MINIO_ENDPOINT（由 docker-compose.yml 自动覆盖为容器服务名）
#   - 含 DB_USERNAME / POSTGRES_DB / VITE_OA_URL 等 Docker 专用变量

# ===================================================================
# 运行环境
# ===================================================================
# Spring Boot 激活的 Profile
SPRING_PROFILES_ACTIVE=dev

# ===================================================================
# PostgreSQL（容器化）
# ===================================================================
# 数据库用户名，docker-compose 同步作为 POSTGRES_USER 创建 postgres 容器
DB_USERNAME=postgres
# 数据库名，docker-compose 同步作为 POSTGRES_DB 创建 postgres 容器
POSTGRES_DB=ai_workmate_dev
# 数据库密码，docker-compose 同步作为 POSTGRES_PASSWORD 创建 postgres 容器
DB_PASSWORD=replace-with-secure-password

# 注意：DB_URL 由 docker-compose.yml 自动覆盖为 jdbc:postgresql://postgres:5432/<POSTGRES_DB>
# 无需在此手动配置；如需指向外部数据库，在此显式设置 DB_URL 即可覆盖自动值。

# ===================================================================
# Redis（容器化）
# ===================================================================
# 注意：REDIS_URL 由 docker-compose.yml 自动覆盖为 redis://redis:6379，无需手动修改
# 如 Redis 设置了密码，在此填写（容器内 redis 服务默认无密码）
REDIS_PASSWORD=
REDIS_DATABASE=0

# ===================================================================
# OA 认证与防滥用策略
# ===================================================================
AUTH_COOKIE_NAME=oa_session
AUTH_SESSION_TTL=86400
# 生产环境（HTTPS）必须设为 true
AUTH_COOKIE_SECURE=false

EMAIL_CODE_TTL=300
EMAIL_CODE_COOLDOWN=60
EMAIL_CODE_HOURLY_LIMIT=5
EMAIL_CODE_DAILY_LIMIT=10
EMAIL_CODE_MAX_ATTEMPTS=5

CAPTCHA_TTL=180
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# ===================================================================
# JWT 签名密钥
# ===================================================================
# 至少 32 字节的随机密钥，生产环境必须替换为强随机字符串
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# ===================================================================
# AI 大模型配置（OpenAI 兼容接口，默认对接 DeepSeek）
# ===================================================================
AI_API_KEY=replace-with-provider-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# ===================================================================
# MinIO（容器化）
# ===================================================================
# 注意：MINIO_ENDPOINT 由 docker-compose.yml 自动覆盖为 http://minio:9000，无需手动修改
# MinIO 访问密钥，docker-compose 同步作为 MINIO_ROOT_USER 创建 minio 容器
MINIO_ACCESS_KEY=minioadmin
# MinIO 私有密钥，docker-compose 同步作为 MINIO_ROOT_PASSWORD 创建 minio 容器（至少 8 位）
MINIO_SECRET_KEY=replace-with-secure-secret
MINIO_BUCKET=ai-workmate
MINIO_REGION=
MINIO_AUTO_CREATE_BUCKET=true

# ===================================================================
# 知识库 Embedding 向量化配置
# ===================================================================
EMBEDDING_ENABLED=true
# Embedding 提供方：local（本地服务）或 api（远程 OpenAI 兼容接口）
EMBEDDING_PROVIDER=local

# --- 本地服务模式 ---
# 注意：容器内无法访问宿主机 127.0.0.1，需改为宿主机 IP 或独立部署 Embedding 服务
EMBEDDING_LOCAL_BASE_URL=http://127.0.0.1:18080
EMBEDDING_LOCAL_MODEL=Qwen3-Embedding-0.6B

# --- 远程 API 模式 ---
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small
EMBEDDING_API_SEND_DIMENSIONS=true

# --- 通用参数 ---
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CONNECT_TIMEOUT_MS=3000
EMBEDDING_READ_TIMEOUT_MS=60000

# --- 文档分块策略 ---
KNOWLEDGE_CHUNK_MAX_CHARS=1000
KNOWLEDGE_CHUNK_OVERLAP_CHARS=120
KNOWLEDGE_MAX_DOCUMENT_CHARS=120000

# --- 检索参数 ---
KNOWLEDGE_RETRIEVAL_TOP_K=5
KNOWLEDGE_RETRIEVAL_MIN_SCORE=0.35

# ===================================================================
# SMTP 邮件服务（发送登录验证码等邮件，必填才能正常使用邮箱登录）
# ===================================================================
SMTP_HOST=
# SMTP 端口：465（SSL） / 587（STARTTLS）
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=AI WorkMate
SMTP_FROM_EMAIL=

# ===================================================================
# 前端构建期参数
# ===================================================================
# 主站"立即尝试"按钮跳转地址，构建期注入到 fronted-main 镜像
# 留空（默认）：代码自动跳到 http://<当前host>:3001/oa/，适配主站 3000 / OA 3001 分离部署
# 同域名同端口反代场景（外部 nginx 用 location /oa/ 统一转发到 fonted-oa 容器）：设为 /oa/
# 独立域名部署：改为完整 URL，如 https://oa.example.com/oa/
VITE_OA_URL=
