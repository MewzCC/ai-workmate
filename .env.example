# ===================================================================
# AI WorkMate 本地开发环境变量配置模板
# ===================================================================
# 使用方法：复制本文件为 .env，然后根据实际环境填入真实值
#   cp .env.example .env
# 生产环境部署前必须修改所有含 "replace-with" 的占位值
# 本文件仅用于本地开发（npm run dev / mvn spring-boot:run），
# Docker 部署请使用 .env.docker.example。

# ===================================================================
# 运行环境
# ===================================================================
# Spring Boot 激活的 Profile，可选值：dev（开发）、test（测试）、prod（生产）
SPRING_PROFILES_ACTIVE=dev

# ===================================================================
# PostgreSQL 数据库 & Redis 缓存
# ===================================================================
# PostgreSQL 数据库密码
DB_PASSWORD=replace-with-local-password

# Redis 连接地址（格式：redis://host:port），本地开发默认 localhost:6379
REDIS_URL=redis://localhost:6379
# Redis 密码，未设置则留空
REDIS_PASSWORD=
# Redis 逻辑数据库编号（0~15），多项目共用 Redis 时建议使用不同编号做数据隔离
REDIS_DATABASE=0

# ===================================================================
# OA 认证与防滥用策略
# ===================================================================
# 会话 Cookie 名称
AUTH_COOKIE_NAME=oa_session
# 会话有效期（秒），86400 = 24 小时
AUTH_SESSION_TTL=86400
# Cookie Secure 标志：开发环境为 false，生产环境（HTTPS）必须设为 true
AUTH_COOKIE_SECURE=false

# 邮箱验证码有效期（秒），300 = 5 分钟
EMAIL_CODE_TTL=300
# 验证码发送冷却间隔（秒），60 = 同邮箱 1 分钟内禁止重复发送
EMAIL_CODE_COOLDOWN=60
# 每小时同一邮箱最多发送验证码次数
EMAIL_CODE_HOURLY_LIMIT=5
# 每天同一邮箱最多发送验证码次数
EMAIL_CODE_DAILY_LIMIT=10
# 单个验证码最多尝试输入次数，超过后该验证码作废
EMAIL_CODE_MAX_ATTEMPTS=5

# 图形验证码有效期（秒），180 = 3 分钟
CAPTCHA_TTL=180
# 登录失败最大次数（同一账号/同一 IP），达到后临时锁定
LOGIN_MAX_FAILURES=5
# 登录锁定时间（秒），900 = 15 分钟
LOGIN_LOCK_SECONDS=900

# ===================================================================
# JWT 签名密钥
# ===================================================================
# 至少 32 字节的随机密钥，用于签发和校验 JWT Token
# 生产环境必须替换为强随机字符串，禁止使用开发默认值
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# ===================================================================
# AI 大模型配置（OpenAI 兼容接口，默认对接 DeepSeek）
# ===================================================================
# AI 服务商的 API Key，必填
AI_API_KEY=replace-with-provider-key
# API 接口基地址，默认使用 DeepSeek 官方地址
AI_BASE_URL=https://api.deepseek.com
# 对话模型名称，可按服务商支持替换（如 gpt-4o、qwen-plus 等）
AI_MODEL=deepseek-v4-flash

# ===================================================================
# MinIO 对象存储（文件上传 / 头像 / 壁纸）
# ===================================================================
# MinIO 服务访问地址
MINIO_ENDPOINT=http://localhost:9000
# MinIO 访问密钥（Access Key）
MINIO_ACCESS_KEY=minioadmin
# MinIO 私有密钥（Secret Key），生产环境务必修改
MINIO_SECRET_KEY=minioadmin123
# 存储桶名称，所有上传文件统一存入此桶
MINIO_BUCKET=ai-workmate
# MinIO 区域设置，留空则使用默认值
MINIO_REGION=
# 应用启动时是否自动创建存储桶（桶不存在时自动创建）
MINIO_AUTO_CREATE_BUCKET=true

# ===================================================================
# 知识库 Embedding 向量化配置
# ===================================================================
# 是否启用 Embedding 功能
EMBEDDING_ENABLED=true
# Embedding 提供方：local（本地服务）或 api（远程 OpenAI 兼容接口）
EMBEDDING_PROVIDER=local

# --- 本地服务模式 ---
# 本地 Embedding 服务地址（如 text-embeddings-inference、FastEmbed 等）
EMBEDDING_LOCAL_BASE_URL=http://127.0.0.1:18080
# 本地加载的向量模型名称
EMBEDDING_LOCAL_MODEL=Qwen3-Embedding-0.6B

# --- 远程 API 模式 ---
# 远程 Embedding API 基地址
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
# 远程 API 密钥（如使用 OpenAI 等服务时必填）
EMBEDDING_API_KEY=
# 远程使用的 Embedding 模型名称
EMBEDDING_API_MODEL=text-embedding-3-small
# 调用远程 API 时是否在请求中携带 dimensions 参数
EMBEDDING_API_SEND_DIMENSIONS=true

# --- 通用参数 ---
# 向量维度，必须与数据库 knowledge_chunk 表定义的 vector(1024) 保持一致
EMBEDDING_DIMENSION=1024
# 单次批量处理文本条数
EMBEDDING_BATCH_SIZE=16
# Embedding 服务连接超时（毫秒）
EMBEDDING_CONNECT_TIMEOUT_MS=3000
# Embedding 服务读取超时（毫秒），较长的文本可能需要更多时间
EMBEDDING_READ_TIMEOUT_MS=60000

# --- 文档分块策略 ---
# 单个文档切片最大字符数，超过则按此大小切割
KNOWLEDGE_CHUNK_MAX_CHARS=1000
# 相邻切片之间的重叠字符数，保证语义连续性，避免关键信息被切在边界
KNOWLEDGE_CHUNK_OVERLAP_CHARS=120
# 单篇文档允许的最大字符数，超过则拒绝入库
KNOWLEDGE_MAX_DOCUMENT_CHARS=120000

# --- 检索参数 ---
# 知识库检索时返回的最相似结果数量（Top-K）
KNOWLEDGE_RETRIEVAL_TOP_K=5
# 检索结果的相似度最低阈值（0.0 ~ 1.0），低于此分数的结果会被过滤掉
KNOWLEDGE_RETRIEVAL_MIN_SCORE=0.35

# ===================================================================
# SMTP 邮件服务（发送登录验证码等邮件，必填才能正常使用邮箱登录）
# ===================================================================
# SMTP 服务器地址（如 smtp.qq.com / smtp.office365.com）
SMTP_HOST=
# SMTP 端口：465（SSL） / 587（STARTTLS）
SMTP_PORT=465
# SMTP 登录账号
SMTP_USERNAME=
# SMTP 密码或授权码
SMTP_PASSWORD=
# 邮件发件人显示名称
SMTP_FROM_NAME=AI WorkMate
# 邮件发件人邮箱地址
SMTP_FROM_EMAIL=
